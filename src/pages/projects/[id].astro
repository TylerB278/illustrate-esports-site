---
import Container from "@components/Container.astro";
import Layout from "@layouts/Layout.astro";

import { type CollectionEntry, getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("projects");
  return posts.map((project) => ({
    params: { id: project.id },
    props: project,
  }));
}

const post = Astro.props;
// This gets the main content from the markdown file and 
// turns it into an Astro component: <Content />
const { Content } = await render(post);
---

<Layout title={post.data.title}>
  <nav id="navBar">
    <a href="../"><img class="logo" src="/SampleLogo-Color-14.png"></img></a>
    <div class="links">
      <a href="/projects/sample" class="navLink">About Us</a>
      <a href="/projects/sample" class="navLink">Breakdowns</a>
      <!-- <a href="/projects/sample" class="navLink">link</a> -->
    </div>
  </nav>
  <Container>
    <h1>{post.data.title}</h1>
    <Content />
  </Container>
</Layout>

<script>

/* When the user scrolls down, hide the navbar. When the user scrolls up, show the navbar */

var scrollTimeout

var prevScrollpos = window.pageYOffset;
window.onscroll = function() {
  var currentScrollPos = window.pageYOffset;
  if (prevScrollpos > currentScrollPos) {
    document.getElementById("navBar").style.top = "0";
  } else {
      document.getElementById("navBar").style.top = "-100px";
  }

  // Event buffering here
  clearTimeout(scrollTimeout)
  scrollTimeout = setTimeout(function(){
    prevScrollpos = currentScrollPos;
  },2) // This delay may need adjustment...
}

</script>

<style>

  #navBar{ transition: top 0.5s; }
  nav{
    position: fixed;
    top: 0px;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
    height: 100px;
  }
  .links{
    padding: 10px;
    background-color: var(--color-accent);
  }
  .navLink{
    margin: 10px;
    padding: 20px;
    font-size: 24px;
    text-decoration: none;
    color: black;
  } .navLink:hover{ color: var(--color-focus-ring); }

  .logo{
    width: 80px;
    height: 80px;
    margin-left: 20px;
    margin-right: 20px;
  }
</style>