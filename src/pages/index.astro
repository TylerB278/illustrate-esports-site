<script>
  window.addEventListener('scroll', function() {
  const navbar = document.getElementById('navtop');
  if (window.scrollY > 120) // Shows after 100px of scrolling
  { 
    navbar?.classList.add('show');
  } else {
    navbar?.classList.remove('show');
  }
});

 const arrowL = document.querySelector(".arrowL");
 const arrowR = document.querySelector(".arrowR");
 const scrollBox = document.getElementsByClassName(".scrollContain");

 const scrollL = function () {
    // alert("YOU'VE BEEN CLICKED!!");
    document.getElementById('scrollContain').scrollLeft -= ((document.getElementById('scrollContain').scrollWidth)/4);
 };

 const scrollR = function () {
    // alert("YOU'VE BEEN CLICKED!!");
    document.getElementById('scrollContain').scrollLeft += ((document.getElementById('scrollContain').scrollWidth)/4);
 };

 arrowL?.addEventListener("click", scrollL);
 arrowR?.addEventListener("click", scrollR);

</script>

<style>

  /* navigation styling */
    nav{
    position: fixed;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 80px;
    width: 100%;
    background-color: var(--color-background);
    z-index: 100;
  }

  #navtop {
  top: -100px; /* Hide above the screen */
  transition: top 0.5s; /* Smooth animation */
  }
  #navtop.show {
    top: 0; /* Slide into view */
  }

  .links{
    margin: 20px;
    align-content: center;
  }
  .navLink{
    /* padding: 20px; */
    font-size: 24px;
    color: white;
    text-decoration: none;
    padding: 5px;
  } .navLink:hover{ color: var(--color-accent); }
  .logo{
    width: 80px;
    margin-left: 20px;
    padding: 5px;
  }

/* hero image */
  .heroImg{
    position: absolute;
    top: 20vh;
    width: 80vw;
    max-width: 1400px;
  }
  .heroContain{
    height: 81vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* About & Case Study Buttons  */
  .pageButtons{
    display: flex;
    position: relative;
    bottom: 0vh;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding-left: 40px;
    padding-right: 40px;
    justify-content: space-between;
  }

  .button{
    font-size: 32pt;
    font-weight: 800;
    padding: 20px;
    color: var(--color-accent);
    text-decoration: none;
  } .button:hover{ outline: 5px solid var(--color-accent); }

  @media (max-width: 750px){
    .pageButtons{
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 40px;
      bottom: 5vh;
    }
  }
  /*Center Content*/
  .intro{
    display: flex;
  }

  .intro a{
    color: var(--color-accent);
  }
  .intro a:hover{
    background-color: var(--color-accent);
    color: var(--color-focus-ring);
  }
  .intro a:visited{ color: var(--color-focus-ring); }
  .intro a:visited:hover{ background-color: var(--color-focus-ring); color: var(--color-accent);}

  /*Scroll Content*/

  .arrowL, .arrowR{
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 7vw;
    height: 35vw;
    /* background-color: var(--color-accent); */
    border: 5px solid var(--color-accent);
    color: var(--color-accent);
    border-radius: 10px;
    opacity: 35%;
    font-size: 10vw;
    z-index: 0;
  }

  .arrowL{ left: 1.7vw; }
  .arrowR{ right: 1.7vw; }

  .arrowL:hover, .arrowR:hover{
    opacity: 100%;
  }

  #scrollContain{
    align-content: center;
    margin-top: 50px;
    padding-left: 20vw;
    margin-bottom: 50px;
    white-space: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    height: 40vw;
    /* border: 10px solid var(--color-accent); */
  }
  .case{
    display: inline-block;
    scroll-snap-align: center;
    width: 70vw;
    height: 35vw;
    margin-right: 20vw;
    border-radius: 20px;
    border: 10px solid #ff660050;
    border-opacity: 50;

    background-image: url(/SampleLogo-Full-19.png);
    background-size: contain;
    background-repeat: no-repeat;

    transition: all 0.3s;
  } .case:hover{scale: 102%;}

  
</style>