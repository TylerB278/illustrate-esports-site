---
import Layout from "@layouts/Layout.astro";
import SampleComponent from "@components/SampleComponent.astro";
import Container from "@components/Container.astro";
import AstroLogo from "@assets/images/astro-logo-light-gradient.png";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Assets } from "astro:assets";
import ProjectButton from "@components/ProjectButton.astro";
import StaticGraphic from "@components/StaticGraphic.astro";
import Footer from "@components/Footer.astro"
import Star1 from "@assets/images/starHeader1.png"
import Star2 from "@assets/images/starHeader2.png"
import Brush1 from "@assets/images/ovalBrush1.png"
import Brush2 from "@assets/images/ovalBrush2.png"
import Crown1 from "@assets/images/crownHeader1.png"
import Crown2 from "@assets/images/crownHeader2.png"
import Stick1 from "@assets/images/joystick1.png"
import Stick2 from "@assets/images/joystick2.png"
import Controller1 from "@assets/images/controller1.png"
import Controller2 from "@assets/images/controller2.png"

---

<Layout title="Esports Visualized">
  <div class="heroContain">
    <img class="heroImg" src="/MainLogo.svg" />
  </div>
  <div class="pageButtons">
    <a class="button" href="/about">About Esports Visualized</a>
    <a class="button" href="/explorations">Explore Case Studies</a>
  </div>
  <StaticGraphic i1={Star1} i2={Star2} l="4%" t="50px" w="10vw"/>
  <StaticGraphic i1={Crown1} i2={Crown2} r="7%" t="380px" w="11vw"/>
  <StaticGraphic i1={Controller1} i2={Controller2} r="20%" t="100px" w="12vw"/>
  <StaticGraphic i1={Stick1} i2={Stick2} l="7%" t="400px" w="11vw"/>
</Layout>

<script>
  window.addEventListener('scroll', function() {
  const navbar = document.getElementById('navtop');
  if (window.scrollY > 120) 
  { 
    navbar?.classList.add('show');
  } else {
    navbar?.classList.remove('show');
  }
});
</script>

<style>

/* hero image */
  .heroImg{
    position: absolute;
    top: 20vh;
    width: 60vw;
    max-width: 1000px;
    min-width: 300px;
  }

  @media (max-width: 800px){
    .heroImg{
      width: 80vw;
    }
  }

  .heroContain{
    height: 70vh;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* About & Case Study Buttons  */
  .pageButtons{
    display: flex;
    position: relative;
    bottom: 0vh;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    margin-top: 0px;
    padding-left: 40px;
    padding-right: 40px;
    justify-content: space-between;
  }

  .button{
    font-size: 28pt;
    text-align: center;
    line-height: 1.2;
    font-weight: 900;
    padding: 20px;
    color: var(--color-accent);
    text-decoration: none;
  } .button:hover{ outline: 5px solid var(--color-accent); }

  @media (max-width: 750px){
    .pageButtons{
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 40px;
      bottom: 5vh;
    }
  }
  
</style>