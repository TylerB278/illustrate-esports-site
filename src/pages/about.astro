---
import Layout from "@layouts/Layout.astro";
import StaticGraphic from "@components/StaticGraphic.astro";
import SampleComponent from "@components/SampleComponent.astro";
import Container from "@components/Container.astro";
import AstroLogo from "@assets/images/astro-logo-light-gradient.png";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Assets } from "astro:assets";
import { Image } from "astro:assets";

import Logo from './MainLogo.svg';
import Stick1 from "@assets/images/joystick1.png"
import Stick2 from "@assets/images/joystick2.png"
import Controller1 from "@assets/images/controller1.png"
import Controller2 from "@assets/images/controller2.png"
import ImagePopout from "@components/ImagePopout.astro";


import Nav from "@components/Nav.astro"
import Footer from "@components/Footer.astro"
import ProjectButton from "@components/ProjectButton.astro";

---

<Layout title="Esports Visualized">
  <Nav hLink="./"/>
  <div style=" margin: 100px; "></div>
  
  <Container>
    <div class="about">
        <Image src={Logo} alt="logo for Esports Visualized" width={800} />
        <h1 class="header">About the Project</h1>
        <p>
          Designing for competitive gaming, or Esports, brings many unique challenges. These can range from confusion in collegiate spaces,
          to lack of funding, to much more. Esports design requires a broad range of general design skills, on top of some unique skills like event design,
          3D compositing and organizational branding. At the same time though, the industry offers boundless opportunities to express your creativity
          in the fast-paced and growing world of competitive gaming.
        </p>
        <p>
          Esports Visualized is a project that focuses on how graphic design takes shape in the context of the Esports community.
          This project highlights a few different fields of graphic design and focuses on how they are relevant and uniquely used in the context of Esports.
          These are done in the form of case studies. For these case studies I did extensive research into a specific field in the context of Esports.
          In the case studies themselves I discuss the aspect of design and how it differs when applied to Esports but take it one step further and apply
          it myself to give a visual demonstration of what is discussed in the case study. These will all be real and applied designsmade and used for a purpose
          in order to give an accurate depiction of what it is like to design for Esports and the unique challenges that come with it.
        </p>
        <p>
          If you’d like to learn more on how you can start playing your favorite games competitively or just join the scene for the enjoyment of all the unique
          opportunities and graphic design that goes on then contact me or visit my portfolio! This project was made as a Senior Thesis project for the 2026 SUNY New Paltz Design show.
          Look for yourself and see what Esports Visualized has to offer, I hope to show you how special the world of designing for Esports truly is!
        </p>
    </div>
  </Container>
  <Footer />
</Layout>

<script>
</script>

<style>
  /*About Section*/
  .about{
    display: flex;
    flex-flow: column nowrap;
    height: fit-content;
    gap: 30px;
    font-size: 18pt;
    padding: 20px;
  }
  .header{
    text-align: center;
    margin-bottom: 10px;
    font-size: 48pt;
    font-weight: 900;
  }
  .fixpos{
    position: fixed;
  }

  @media (max-width: 600px){
    .about{
      padding: 0px;
      font-size: 14px;
    }
  }

  @media (max-width: 800px){
    .header{
      font-size: clamp(23pt, 8vw, 48pt);
    }
  }
</style>