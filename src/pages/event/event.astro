---
import Image from "astro/components/Image.astro";
import Container from "@components/Container.astro";
import Layout from "@layouts/Layout.astro";
import ImagePopout from "@components/ImagePopout.astro";
import Gap from "@components/Gap.astro";

import Thumb from './thumbnail.png';

---

<Layout title= "Event Design">
  <nav id="navBar">
    <a href="../"><img class="logo" src="/SampleLogo-White-16.png"></img></a>
    <div class="links">
      <a href="/projects/sample" class="navLink">About Us</a>
      <a href="/projects/sample" class="navLink">Breakdowns</a>
      <!-- <a href="/projects/sample" class="navLink">link</a> -->
    </div>
  </nav>
  <div class="page-contain">
    <div class="text-contain">
      <h1 class="header">Event Design</h1>
      <div class="textgroup">
        <h2>What is Event Design</h2>
        <p>What is Event Design What is Event Design What is Event Design What is Event Design What is Event Design</p>
      </div>
      <h2>What is Event Design</h2>
      <p>What is Event Design What is Event Design What is Event Design What is Event Design What is Event Design</p>
    </div>
    <div class="image-contain">
      <!-- <Gap h="400px" /> -->
      <ImagePopout image={Thumb} alt="image test" w="100%" galleryID="1"/>    
      <ImagePopout image={Thumb} alt="image test" w="100%" galleryID="1"/>
      <ImagePopout image={Thumb} alt="image test" w="100%" galleryID="1"/>
      <ImagePopout image={Thumb} alt="image test" w="100%" galleryID="1"/>
    </div>
  </div>
</Layout>

<script>

/* When the user scrolls down, hide the navbar. When the user scrolls up, show the navbar */

var scrollTimeout

var prevScrollpos = window.pageYOffset;
window.onscroll = function() {
  var currentScrollPos = window.pageYOffset;
  if (prevScrollpos > currentScrollPos) {
    document.getElementById("navBar").style.top = "0";
  } else {
      document.getElementById("navBar").style.top = "-100px";
  }

  // Event buffering here
  clearTimeout(scrollTimeout)
  scrollTimeout = setTimeout(function(){
    prevScrollpos = currentScrollPos;
  },2) // This delay may need adjustment...
}

</script>

<style>

  #navBar{ transition: top 0.5s; }
  nav{
    position: fixed;
    top: 0px;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    width: 100%;
    height: 100px;
  }
  .links{
    padding: 10px;
    background-color: var(--color-background);
  }
  .navLink{
    margin: 10px;
    padding: 20px;
    font-size: 24px;
    text-decoration: none;
    color: var(--color-text);
  } .navLink:hover{ color: var(--color-accent); }

  .logo{
    width: 80px;
    height: 80px;
    margin-left: 20px;
    margin-right: 20px;
  }

  .page-contain{
    display: grid;
    align-items: top;
    grid-template-columns: 550px 1fr;
    margin: var(--size-page-margin) 0;
  }
  .text-contain{
    display: flex;
    flex-direction: column;
    align-items: center;
    /* justify-content: space-evenly; */
    gap: 8rem;
    background-color: var(--color-background);
    height: 100%;
    padding: 3rem;
    padding-top: 8rem;
  }
  .image-contain{
    display: flex;
    flex-flow: column wrap;
    justify-content: space-around;
    padding: 1rem;
    border-left: 5px solid var(--color-accent);
    height: 300vh;
  }

  .header{
    font-size: 48pt;
    font-weight: 800;
  }
</style>