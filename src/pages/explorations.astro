---
import Layout from "@layouts/Layout.astro";
import SampleComponent from "@components/SampleComponent.astro";
import Container from "@components/Container.astro";
import AstroLogo from "@assets/images/astro-logo-light-gradient.png";
import { Content as SampleMarkdown } from "@content/sample-markdown.md";
import { Assets } from "astro:assets";
import { Image } from "astro:assets";

import Logo from './MainLogo.png';
import Event from '@assets/images/EventCase-Cover.png';
import EventText from '@assets/images/EventCase-Text.png';
import Collegiate from '@assets/images/CollegiateCase-Cover.png';
import CollegiateText from '@assets/images/CollegiateCase-Text.png';
import Composite from '@assets/images/3DCase-BG.png';
import CompositeText from '@assets/images/3DCase-Cover.png';

import ImagePopout from "@components/ImagePopout.astro";
import StaticGraphic from "@components/StaticGraphic.astro";
import FTF1 from "@assets/images/fist1.png"
import FTF2 from "@assets/images/fist2.png"
import Hawk1 from "@assets/images/hawk5.png"
import Hawk2 from "@assets/images/hawk6.png"
import Cube1 from "@assets/images/cube1.png"
import Cube2 from "@assets/images/cube2.png"


import Nav from "@components/Nav.astro"
import Footer from "@components/Footer.astro"
import ProjectButton from "@components/ProjectButton.astro";

---

<Layout title="Esports Visualized">
  <Nav hLink="./" />
  <div class="caseFlex">
    <a class="caseBox event" href="/event/event">
      <Image alt="" class="background" src={EventText} width={800} />
      <div class="symbol">
        <StaticGraphic i1={FTF1} i2={FTF2} l="30%" t="-10%" w="40%"/>
      </div>
      <Image alt="" class="overlay" src={Event} width={800} />
    </a>
    <a class="caseBox collegiate" href="/collegiate/collegiate">
      <Image alt="" class="background" src={CollegiateText} width={800} />
      <div class="symbol">
        <StaticGraphic i1={Hawk1} i2={Hawk2} l="30%" t="-10%" w="40%"/>
      </div>
      <Image alt="" class="overlay" src={Collegiate} width={800} />
    </a>
    <a class="caseBox 3d" href="/3d/3d">
      <Image alt="" class="background" src={CompositeText} width={800} />
      <div class="symbol">
        <StaticGraphic i1={Cube1} i2={Cube2} l="30%" t="-10%" w="40%"/>
      </div>
      <Image alt="" class="overlay" src={Composite} width={800} />
    </a>
  </div>
  <div class="foot">
    <Footer />
  </div>
</Layout>

<script></script>

<style>

.caseFlex{
  display: flex;
  flex-flow: row wrap;
  justify-content: center;
  align-items: center;
  gap: 100px;
  margin-top: 170px;
  height: 75vh;
}

.caseBox{
  position: relative;
  display: flex;
  max-width: 600px;
  justify-content: center;
  transition: all 0.5s;
  margin: 20px;
  
}

.background{
  justify-self: center;
  align-self: center;
  width: 60%;
  transition: all 0.2s;
  scale: 180%;
}

.overlay{
  background-origin: center;
  transform-origin: center;
  position: absolute;
  top: 50%;
  left: 50%;
  translate: -50% -50%;
  width: 80%;
  z-index: -100;
  transform: scale(0%);
  transition: all 0.4s;
}

.symbol{ transition: all 0.5s; z-index: -1; }

.caseBox:hover .background{ scale: 200%; }
.caseBox:hover .overlay{ transform: scale(150%); }
.caseBox:hover .symbol{ opacity: 0%; }

.foot{
  position: fixed;
  width: 100%;
  bottom: 0;
}

@media (max-width: 980px){
  .caseFlex{
    margin-top: 100px;
    gap: 50px;
  }
}

@media (max-width: 1379px){
  .caseBox{ max-width: 400px; }
}
</style>