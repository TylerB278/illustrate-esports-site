---
// This is a simple container component that centers its content and provides padding
---

<div class="container">
  <slot />
</div>

<style>
  /* uses flex to center items on the page.*/
  .container {
    background-color: #0f00215b;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-self: center;
    max-width: 2000px;
    margin-left: 30px;
    margin-right: 30px;
    padding-top: 50px;
    padding-bottom: 50px;
    gap: 0.5rem;
  }

  @media (max-width: 600px){
    .container{
      margin-left: 0px;
      margin-right: 0px;
    }
  }

  .container > :global(*) {
    /* sets the default width on anything inside this container*/
    /* note: you can still override this on an individual basis by setting its max-width */
    max-width: calc(
      min(100%, var(--size-page-width)) - 2 * var(--size-page-padding)
    );
    width: 100%;
  }
</style>
