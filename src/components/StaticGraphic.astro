---
import Image from "astro/components/Image.astro";

const { i1 } = Astro.props;
const { i2 } = Astro.props;
const { w } = Astro.props;
const { t } = Astro.props;
const { b } = Astro.props;
const { l } = Astro.props;
const { r } = Astro.props;

---

<div class="imgFit">
  <Image class="image-component main" alt=`` src={i1} width={500} style=`width: ${w}; top: ${t}; bottom: ${b}; left: ${l}; right: ${r};`/>
  <Image class="image-component alt" alt=`` src={i2} width={500} style=`width: ${w}; top: ${t}; bottom: ${b}; left: ${l}; right: ${r};`/>
</div>
<style>
  .image-component {
    position: absolute;
    z-index: -1;
    min-width: 100px;
  }

  .main{ animation: MainAnim 1s; animation-timing-function: steps(1, end); animation-iteration-count: infinite;}
  .alt{ animation: AltAnim 1s; animation-timing-function: steps(1, end); animation-iteration-count: infinite;}

  @media(max-width: 850px){
    .imgFit{
      height: fit-content;
    }
  }

@keyframes MainAnim{
    0% { 
      opacity: 100%;
    }
    50% { 
      opacity: 0%;
    }
    100% { 
      opacity: 100%;
    }
  }

  @keyframes AltAnim{
    0% { 
      opacity: 0%;
    }
    50% { 
      opacity: 100%;
    }
    100% { 
      opacity: 0%;
    }
  }

</style>