---
import { Assets } from "astro:assets";

const { hLink } = Astro.props;

---

<nav id="navBar">
    <a class="logo" href={hLink}></a>
    <div class="links">
        <a href="/about" class="navLink">About</a>
        <a href="/explorations" class="navLink">Case Studies</a>
    </div>
</nav>

<script>

var scrollTimeout

var prevScrollpos = window.pageYOffset;
window.onscroll = function() {
  var currentScrollPos = window.pageYOffset;
  if (prevScrollpos > currentScrollPos) {
    document.getElementById("navBar").classList.remove("top150");
    document.getElementById("navBar").classList.add("top0");
  } else {
    document.getElementById("navBar").classList.add("top150");
    document.getElementById("navBar").classList.remove("top0");
  }

  // Event buffering here
  clearTimeout(scrollTimeout)
  scrollTimeout = setTimeout(function(){
    prevScrollpos = currentScrollPos;
  },2) // This delay may need adjustment...
}

</script>

<style>

    #navBar{ transition: top 0.5s; }

    @media (min-width: 600px){ 
        .top150{ top: -150px; }
    }
    .top0{ top: 0px; }

    nav{
        position: fixed;
        top: 0px;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        width: 100%;
        /* height: 100px; */
        margin: 20px;
        z-index: 1000;
    }
    .links{
        padding: 10px;
        background-color: var(--color-background);
    }
    .navLink{
        margin: 10px;
        padding: 20px;
        font-size: 24px;
        text-decoration: none;
        color: var(--color-text);
    } .navLink:hover{ color: var(--color-accent); }

    .logo{
        background-image: url(/NavWhite.svg);
        background-repeat: no-repeat;
        height: 80px;
        width: 73px;
        margin-left: 20px;
        margin-right: 20px;
        transition: 0.3s all;
    }
    .logo:hover{
        background-image: url(/NavColor.svg);
    }

    @media (max-width: 600px){
        nav{
            margin: 10px;
        }
        .navLink{
        padding: 10px;
        font-size: 14pt;
        }
        .logo{
            height: 70px;
            margin-left: 5px;
            margin-right: 5px;
        }
    }

</style>