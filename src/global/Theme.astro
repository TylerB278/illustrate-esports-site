---
// we can import fonts here, after installing them via Fontsource
// see https://fontsource.org/docs/installation for instructions
import "@fontsource/karla";
---

<style is:global>
  /* We can use this style tag to set up colors, fonts, etc. */
  @font-face {
    font-family: Minstrel; /* set name */
    src: url(MinstrelPoster.woff); /* url of the font */
    
    font-weight: normal;
    font-style: normal;
  }

  :root {
    --color-background: #0F0021;
    --color-text: #FFF;
    --color-accent: #FFBC00;
    --color-focus-ring: #FF6400;

    --font-body: "Karla", sans-serif;
    --font-headings: "Karla", sans-serif;

    font-size: 18px;

    /* These sizes are used by the Container component to set up the page container */
    --size-page-width: 800px;
    --size-page-padding: 1rem;
  }

  /* We can also apply these colors as a default */
  body {
    background-image: url(/IllustrateEsports-DesignBlog-BackgroundTexture.png);
    background-size: cover;
    background-repeat: no-repeat;
    background-attachment: fixed;
    background-position: center;
    background-color: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-body);
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-weight: 800;
    color: var(--color-accent);
  }

  a{ color: var(--color-accent); }
  a:visited{ color: var(--color-focus-ring); }

  ::-moz-selection { /* Code for Firefox */
  background: #ffbb0085;
  }

  ::selection {
    background: #ffbb0085;
  }
  
  /* default focus ring styles */
  *:focus-visible {
    outline: 3px solid var(--color-focus-ring);
  }

  ::-webkit-scrollbar {
      width: .4rem;
      height: 15px;
  }

  ::-webkit-scrollbar-track {
      /* box-shadow: inset 0 0 3px var(--color-accent); */
      border-radius: 0px;
  }

  ::-webkit-scrollbar-thumb {
      background: var(--color-accent);
      border-radius: 5px;
  }
</style>
